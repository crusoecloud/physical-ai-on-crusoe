# Secrets and local environment files
.env
.env.*
*.pem
*.key

# Terraform state, in case an old checkout or the legacy archive is restored here
**/*.tfstate
**/*.tfstate.*
**/.terraform/
**/terraform.tfvars

# Scratch from subagent-driven runs (also self-ignored, listed so the intent is visible)
.superpowers/

# Python bytecode
__pycache__/
*.pyc

# Local session-artifact scratch (handoffs, notes) — never tracked
.planning/
.claude/*
